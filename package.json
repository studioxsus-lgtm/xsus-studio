{
  "name": "xsus-ai-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bërthama shumëgjuhëshe e inteligjencës artificiale për XSUS Studio",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:services": "vitest run services",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm test && npm run test:coverage",
    "check:hyper-deployment": "node scripts/check-hyper-deployment.js",
    "check:dependencies": "node scripts/check-rollup-install.js",
    "report:glob": "node scripts/report-glob-dependencies.js",
    "test:hyper-regression": "vitest run tests/integration/hyper-specialist-output-workflow-contract.test.js tests/integration/hyper-result-plan-bounded-scan.test.js tests/integration/hyper-result-plan-id-contract-parity.test.js tests/integration/hyper-result-envelope-descriptor-admission.test.js tests/integration/hyper-five-engine-workflow.test.js",
    "check:hyper-regression": "npm run check:dependencies && npm run test:hyper-regression"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4",
    "vite": "^6.4.5"
  },
  "overrides": {
    "rollup": "4.68.4"
  }
}
